{
  "name": "idleo-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "api:types": "openapi-typescript ../api/openapi.yaml --output src/api/schema.gen.ts",
    "tokens": "node scripts/tokens-css.ts",
    "prepare-sources": "pnpm api:types && pnpm tokens",
    "dev": "pnpm prepare-sources && vite",
    "build": "pnpm prepare-sources && tsc --noEmit && vite build && vite build --ssr src/prerender.tsx --outDir dist-ssr && node scripts/postbuild.ts",
    "build:site": "pnpm prepare-sources && vite build --config vite.site.config.ts && vite build --config vite.site.config.ts --ssr src/site/render.tsx --outDir dist-site-ssr && node scripts/build-site.ts",
    "serve": "node scripts/serve.ts",
    "serve:site": "IDLEO_DIST=dist-website PORT=3002 node scripts/serve.ts",
    "typecheck": "pnpm prepare-sources && tsc --noEmit",
    "lint": "pnpm prepare-sources && eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm prepare-sources && vitest run",
    "size": "node scripts/first-load.ts && node scripts/site-size.ts",
    "e2e": "playwright test --project='screens-*' --project=journey",
    "screenshots": "node e2e/screenshots.ts",
    "gallery": "GALLERY_DIR=${GALLERY_DIR:-../private/review/web-booking} SKIP_VISUAL=1 playwright test --project='screens-*' --project=recording && GALLERY_DIR=${GALLERY_DIR:-../private/review/web-booking} BEFORE_DIR=${BEFORE_DIR:-../private/review/web-foundations} node scripts/gallery.ts",
    "lighthouse": "playwright test --project=lighthouse && lhci assert --config=lighthouserc.json"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@tanstack/query-async-storage-persister": "5.104.1",
    "@tanstack/query-persist-client-core": "5.104.1",
    "@tanstack/react-query": "5.104.1",
    "clsx": "2.1.1",
    "firebase": "12.19.0",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.52.0",
    "oidc-client-ts": "3.5.0",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "uqr": "0.1.3",
    "web-vitals": "6.2.3",
    "wouter": "3.13.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "lighthouse": "13.5.0",
    "marked": "18.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
