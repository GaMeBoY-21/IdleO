{
  "name": "idleo-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "api:types": "openapi-typescript ../api/openapi.yaml --output src/api/schema.gen.ts",
    "tokens": "node scripts/tokens-css.ts",
    "prepare-sources": "pnpm api:types && pnpm tokens",
    "dev": "pnpm prepare-sources && vite",
    "dev:host": "pnpm prepare-sources && IDLEO_WEB_SITE=host vite",
    "dev:admin": "pnpm prepare-sources && IDLEO_WEB_SITE=admin vite",
    "build": "pnpm prepare-sources && tsc --noEmit && node scripts/build-sites.ts",
    "build:site": "pnpm prepare-sources && vite build --config vite.site.config.ts && vite build --config vite.site.config.ts --ssr src/site/render.tsx --outDir dist-site-ssr && node scripts/build-site.ts",
    "serve": "node scripts/serve.ts",
    "serve:host": "IDLEO_DIST=dist-host PORT=3003 node scripts/serve.ts",
    "serve:admin": "IDLEO_DIST=dist-admin PORT=3004 node scripts/serve.ts",
    "serve:site": "IDLEO_DIST=dist-website PORT=3002 node scripts/serve.ts",
    "typecheck": "pnpm prepare-sources && tsc --noEmit",
    "lint": "pnpm prepare-sources && eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm prepare-sources && vitest run",
    "size": "node scripts/first-load.ts && IDLEO_WEB_SITE=host node scripts/first-load.ts && IDLEO_WEB_SITE=admin node scripts/first-load.ts && node scripts/site-modules.ts && node scripts/site-size.ts",
    "e2e": "playwright test --project='screens-*' --project=journey",
    "screenshots": "node e2e/screenshots.ts",
    "brand-assets": "node scripts/brand-assets.ts",
    "gallery": "GALLERY_DIR=${GALLERY_DIR:-../private/review/web-booking} SKIP_VISUAL=1 playwright test --project='screens-*' --project=recording && GALLERY_DIR=${GALLERY_DIR:-../private/review/web-booking} BEFORE_DIR=${BEFORE_DIR:-../private/review/web-foundations} node scripts/gallery.ts",
    "lighthouse": "node scripts/lighthouse.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.3",
    "@tanstack/query-async-storage-persister": "5.107.1",
    "@tanstack/query-persist-client-core": "5.107.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-virtual": "3.14.26",
    "clsx": "2.1.1",
    "firebase": "13.2.0",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.70.0",
    "oidc-client-ts": "3.5.0",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "uqr": "0.1.3",
    "web-vitals": "6.2.3",
    "wouter": "3.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.7",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "lighthouse": "13.6.0",
    "marked": "18.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
