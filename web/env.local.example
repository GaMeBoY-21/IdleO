# Copy to .env.local for `pnpm dev` against the local stack (scripts/e2e/agent-online.sh --keep-running).
IDLEO_DEPLOYMENT=local
VITE_API_URL=http://localhost:8080
VITE_STORAGE_URL=http://localhost:9100
VITE_AUTH=oidc-mock
VITE_OIDC_ISSUER=http://localhost:8099/idleo-local
VITE_OIDC_CLIENT_ID=idleo-local
# The public site's address, for its sitemap and links; a local build may leave it out (ADR 0029).
# IDLEO_SITE_URL=http://localhost:3000
