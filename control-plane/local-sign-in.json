{
  "interactiveLogin": false,
  "tokenCallbacks": [
    {
      "issuerId": "idleo-local",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "grant_type",
          "match": "client_credentials",
          "claims": {
            "sub": "${clientId}",
            "user_id": "${clientId}",
            "aud": [
              "idleo-local"
            ],
            "email": "${clientId}@example.com",
            "email_verified": true,
            "name": "Local Developer",
            "firebase": {
              "sign_in_provider": "password",
              "identities": {
                "email": [
                  "${clientId}@example.com"
                ]
              }
            }
          }
        },
        {
          "requestParam": "grant_type",
          "match": "authorization_code",
          "claims": {
            "sub": "${login_hint}",
            "user_id": "${login_hint}",
            "aud": [
              "idleo-local"
            ],
            "email": "${login_hint}@example.com",
            "email_verified": true,
            "name": "Local Developer",
            "firebase": {
              "sign_in_provider": "password",
              "identities": {
                "email": [
                  "${login_hint}@example.com"
                ]
              }
            }
          }
        }
      ]
    }
  ]
}
