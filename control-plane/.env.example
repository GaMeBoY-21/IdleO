# Every environment variable the control plane reads, with fake values.
# Copy to .env (gitignored) and load it into your shell before running:
#   set -a && . ./.env && set +a
# The test profile needs none of these; it runs its own database and issuers.

# Trusted ID token issuers (ADR 0009). For Google Identity Platform the issuer
# is https://securetoken.google.com/<project-id> and the audience is the
# project id. Needed by every profile except test. Add _1_ variables for a
# second issuer during a provider move.
IDENTITY_ISSUERS_0_ISSUERURI=https://securetoken.google.com/demo-project
IDENTITY_ISSUERS_0_AUDIENCE=demo-project

# Production only (the local profile runs compose.yaml's database).
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=jdbc:postgresql://db.example.invalid:25060/controlplane?sslmode=require
DATABASE_USERNAME=controlplane
DATABASE_PASSWORD=fake-password-change-me
