# The nightly full backup of the database (ADR 0036, docs/runbooks/backups.md): install with idleo-backup.timer in
# /etc/systemd/system/ on the database's server, with the repository checked out at /opt/idleo and the database's
# container named in IDLEO_DATABASE_CONTAINER. A failure shows in `systemctl status idleo-backup` and journalctl; the
# control plane's no-backup alert fires if no full backup finishes in 26 hours, whatever the reason.
[Unit]
Description=IdleO database full backup
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
Environment=IDLEO_DATABASE_CONTAINER=idleo-postgres
ExecStart=/opt/idleo/ops/backup/backup-now.sh
