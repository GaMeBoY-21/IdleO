#!/bin/bash
# The image's entrypoint (ADR 0036): PostgreSQL's own, with WAL archiving through WAL-G when backups are configured
# (WALG_S3_PREFIX set), and without when they aren't (the tests' and the end-to-end stacks'). Archiving switches to a
# new WAL segment at least every 30 seconds, so at most about 30 seconds of committed work is ever only on this disk.
#
# A new volume is initialised first without archiving: the official entrypoint's initialisation stops its temporary
# server at the end, and a stop waits for every WAL segment to be archived, so storage that isn't there yet would hold
# the database's very first start. WAL from before the first full backup can't be restored from anyway.
set -euo pipefail
if [[ "${1:-}" != postgres || -z "${WALG_S3_PREFIX:-}" ]]; then
  exec docker-entrypoint.sh "$@"
fi
shift
if [[ ! -s "${PGDATA:?}/PG_VERSION" ]]; then
  docker-entrypoint.sh postgres -c archive_mode=off -c listen_addresses='' "$@" &
  initialising=$!
  # Initialised once the entrypoint has replaced itself with the server (it runs a temporary one first) and it answers.
  until [[ "$(cat "/proc/$initialising/comm" 2>/dev/null)" == postgres ]] && pg_isready -q -h /var/run/postgresql; do
    kill -0 "$initialising" 2>/dev/null || { echo "idleo-postgres: initialisation failed" >&2; exit 1; }
    sleep 0.5
  done
  gosu postgres pg_ctl -D "$PGDATA" -m fast -w stop >/dev/null
  wait "$initialising" || true
fi
exec docker-entrypoint.sh postgres -c archive_mode=on -c archive_command='archive-wal %p' -c archive_timeout=30 "$@"
