// Renovate, for what Dependabot can't read (ADR 0048): the cluster's vendors, pinned in Flux's manifests and in Helm
// values as tag@digest. Every week, one grouped pull request moves them all to their latest stable release, each
// re-pinned by digest; its checks (the deploy check's kyverno test, the security, gitops and k8s workflows) prove the
// signatures and the cluster before a person merges it. Dependabot keeps everything else (.github/dependabot.yml).
// Run by .github/workflows/renovate.yml as the deploy app.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  timezone: 'Asia/Kolkata',
  schedule: ['before 9am on monday'],
  dependencyDashboard: false,
  // Only these: the ecosystems Dependabot covers stay Dependabot's.
  enabledManagers: ['flux', 'kustomize', 'custom.regex'],
  flux: {
    // Flux's own components (gotk-components.yaml, regenerated by `flux install --export`) and the vendors' charts
    // (each OCIRepository's tag, beside its digest).
    managerFilePatterns: ['/^deploy/.+\\.ya?ml$/'],
  },
  kustomize: {
    // Flux's controller images, newTag and digest together (deploy/flux/kustomization.yaml).
    managerFilePatterns: ['/^deploy/flux/kustomization\\.yaml$/'],
  },
  customManagers: [
    {
      // An image written whole: registry/repository:tag@sha256:digest, in a manifest, values or a check's pinned tool.
      customType: 'regex',
      managerFilePatterns: [
        '/^deploy/.+\\.ya?ml$/',
        '/^scripts/checks/deploy\\.sh$/',
        '/^scripts/deploy/policy-test\\.sh$/',
        '/^scripts/k8s/kube-bench\\.sh$/',
      ],
      matchStrings: [
        '(?<depName>(?:docker\\.io|ghcr\\.io|quay\\.io)/[a-z0-9._/-]+):(?<currentValue>[A-Za-z0-9._-]+)@(?<currentDigest>sha256:[0-9a-f]{64})',
      ],
      datasourceTemplate: 'docker',
    },
    {
      // A chart's image given as tag@digest, its repository in the comment above (the chart supplies it).
      customType: 'regex',
      managerFilePatterns: ['/^deploy/infrastructure/.+\\.ya?ml$/'],
      matchStrings: [
        '# renovate: image=(?<depName>\\S+)\\n\\s+tag: (?<currentValue>[A-Za-z0-9._-]+)@(?<currentDigest>sha256:[0-9a-f]{64})',
        '# renovate: image=(?<depName>\\S+)\\n\\s+tag: (?<currentValue>[A-Za-z0-9._-]+)\\n\\s+digest: (?<currentDigest>sha256:[0-9a-f]{64})',
      ],
      datasourceTemplate: 'docker',
    },
  ],
  packageRules: [
    {
      // Everything here in one pull request a week.
      matchManagers: ['flux', 'kustomize', 'custom.regex'],
      groupName: 'cluster vendors',
      groupSlug: 'cluster-vendors',
      pinDigests: true,
    },
    {
      // Ours: release.py moves our images and chart (ADR 0046), never Renovate.
      matchPackageNames: ['ghcr.io/gameboy-21/**', 'oci://ghcr.io/gameboy-21/**'],
      enabled: false,
    },
    {
      // The policy tests' fixtures are fixed on purpose (real, signed or unsigned digests of a known build).
      matchFileNames: ['deploy/policies/tests/**', 'deploy/clusters/**/release.yaml'],
      enabled: false,
    },
    {
      // PostgreSQL's major version is a migration (ADR 0047), not an update.
      matchPackageNames: ['ghcr.io/cloudnative-pg/postgresql'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
  ],
}
